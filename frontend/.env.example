# Copiem para frontend/.env.local e preencham com o projeto Supabase de DESENVOLVIMENTO.
# O frontend só usa o Supabase para o LOGIN. Tudo o resto passa pela API em Python (/api/...).
# A chave publishable pode ir para o browser. NUNCA ponham aqui a secret key.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXX

# development | preview | production
VITE_APP_ENV=development
