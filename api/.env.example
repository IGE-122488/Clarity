# Copiem para api/.env e preencham com o projeto Supabase de DESENVOLVIMENTO.
# A API usa a chave PUBLISHABLE + o token do psicólogo, para que as regras RLS se apliquem sempre.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXX

# development | preview | production
APP_ENV=development

# Passo 4 — briefing por IA (Azure OpenAI). Opcional: sem isto, só o briefing fica indisponível.
# Valores em Microsoft Foundry → Modelos → a implementação → Detalhes. A CHAVE NUNCA VAI PARA O GIT.
# O endereço pode ser copiado tal como aparece no portal (com ou sem "/responses" no fim).
AZURE_OPENAI_BASE_URL=https://SEU-RECURSO.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=briefing
AZURE_OPENAI_API_KEY=

# Passo 5 — digitalizar notas manuscritas (Azure Document Intelligence, plano F0). Opcional.
# Valores no portal do Azure → recurso de Document Intelligence → Chaves e Ponto Final.
AZURE_DOCINTEL_ENDPOINT=https://SEU-RECURSO.cognitiveservices.azure.com/
AZURE_DOCINTEL_KEY=

# Mais tarde (passo 9): BREVO_API_KEY, CRON_SECRET.
